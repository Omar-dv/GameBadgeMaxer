# Your Discord User Account Token (NEVER share this with anyone!)
DISCORD_TOKEN=your_discord_token_here

# Rotation duration per game in minutes (Default: 30)
ROTATION_MINUTES=30

# Target number of unique games to max out Game Variety badge (Default: 100)
TARGET_GAMES_COUNT=100

# Enable Streaming activity presence for Streaming badge (true / false)
STREAMING_ENABLED=true

# Streaming broadcast channel URL (Twitch or YouTube)
STREAMING_URL=https://www.twitch.tv/discord

# Stream title displayed on your Discord profile
STREAM_TITLE=🔴 Road to Max Gaming Badges | EnzoCord

# Enable local Windows process spoofer (spawns 0% CPU 3.5KB stubs for desktop detection)
ENABLE_LOCAL_PROCESS_SPOOFER=true
